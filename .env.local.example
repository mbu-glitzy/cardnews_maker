# ============================================================
# 이 파일은 GIT에 커밋됩니다. 실제 키는 절대 여기에 넣지 마세요.
# 실제 키는 .env.local (gitignore 됨)에 입력하세요.
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# Supabase 서비스 롤 키 (서버 전용 - 절대 클라이언트 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI API 키
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx
GOOGLE_AI_API_KEY=AIzaSyXXXXXXXX
OPENAI_API_KEY=sk-proj-xxxxxxxx

# 암호화 키 (DB에 저장되는 API 키를 암호화하기 위한 마스터 키)
# 생성 명령: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=your-32-byte-base64-key

# Meta (Instagram Graph API) — Phase 6
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0
